# Komun environment variables
# Copy this to .env and fill in your values
# The .env file is gitignored and will never be committed

# Database
DB_USER=komun
DB_PASSWORD=generate-a-strong-password-here
DB_NAME=komun

# The server loads this file too (dotenvy). The overrides it honours are
# KOMUN_CONFIG, DATABASE_URL, BIND_ADDR, KOMUN_BIND_ADDRESS, KOMUN_PORT and
# KOMUN_NODE_NAME; everything else is configured by config.toml —
# config.example.toml is the documented template.
